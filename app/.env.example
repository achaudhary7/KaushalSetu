# ============================================================================
# KaushalSetu — environment contract
#
# Copy to `.env` and fill in. `.env` is git-ignored and must never be committed.
# Every variable here is validated at boot by src/lib/env.ts, which fails loudly
# and by name if a required one is missing.
# ============================================================================

# ---- Site ------------------------------------------------------------------
# The canonical origin. Canonicals, the sitemap, OpenGraph URLs and JSON-LD all
# derive from this, so it MUST match the host actually served — including the
# www / non-www decision. A mismatch here is the classic post-launch SEO bug.
#   dev     http://localhost:3000
#   tunnel  https://<something>.trycloudflare.com
#   prod    https://kaushalsetu.in
NEXT_PUBLIC_SITE_URL="http://localhost:3000"


# ---- Database (Phase 3+) ---------------------------------------------------
# dev   file:./dev.db
# prod  mysql://kaushal:PASSWORD@localhost:3306/kaushalsetu
DATABASE_URL="file:./dev.db"


# ---- Authentication (Phase 4+) ---------------------------------------------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"


# ---- Email (Phase 4+) ------------------------------------------------------
# Leave unset in development — email falls back to a console transport that
# prints the message instead of sending it.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="KaushalSetu <noreply@kaushalsetu.in>"


# ---- Uploads (Phase 12) ----------------------------------------------------
# Must resolve OUTSIDE the web root in production. Documents are served only
# through an authorised route issuing short-lived signed URLs.
UPLOAD_DIR="./uploads"


# ---- AI (Phase 14 — last, by design) ---------------------------------------
# The platform is fully functional with AI_ENABLED=false. That is not a
# limitation, it is the architecture: every AI feature has a shipped
# deterministic fallback. See ADR-002 and docs/phases/phase-14-ai-layer.md.
AI_ENABLED="false"
ANTHROPIC_API_KEY=""
